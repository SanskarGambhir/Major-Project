# =============================================================================
# TEMPLATE — copy to .env.
#
#   Windows:  Copy-Item .env.example .env
#   macOS:    cp .env.example .env
#
# =============================================================================
#
#  ⚠  EVERY VALUE HERE IS PUBLIC.
#
#  Vite bakes VITE_* variables into the JavaScript bundle at build time. They
#  ship to the browser and anyone can read them with devtools.
#
#  NEVER put an API key, database password, or JWT secret here. If the browser
#  needs something that requires a secret, it asks OUR SERVER, and the server
#  holds the secret.
#
#  Only VITE_-prefixed variables reach the app; Vite ignores the rest.
# =============================================================================

VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
VITE_DEMO_API_URL=http://localhost:3001

VITE_DEMO_MODE=true
