# =============================================================================
# NEVER COMMIT THESE
# =============================================================================

# Environment files hold database passwords, API keys, and signing secrets.
# The .env.example files ARE committed — they are templates with no real values.
.env
.env.*
!.env.example
!.env.*.example

# Dependencies — reinstall with `npm install` / `pip install -r requirements.txt`.
# These contain compiled binaries built for one machine and do not transfer.
node_modules/
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Build output
dist/
dist-ssr/
build/
*.local

# ChromaDB vector store (Phase 6) — regenerated by the seed script
chroma_data/

# Database backups may contain real incident data
backups/
*.sql.bak
sre_backup*.sql
sre_data*.sql

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.swp

# Claude Code local settings
.claude/settings.local.json
