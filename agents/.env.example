# =============================================================================
# TEMPLATE — copy to .env and add your own API key.
#
#   Windows:  Copy-Item .env.example .env
#   macOS:    cp .env.example .env
#
# The .env you create holds the most sensitive value in the project. A leaked
# Gemini key can be used by anyone, billed to you, until you revoke it.
# =============================================================================

# --- Google Gemini (primary LLM) ---------------------------------------------
# Free key: https://aistudio.google.com/apikey
# Leave blank and the service still runs — it falls back to rule-based
# decisions, which work but produce no real AI analysis.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_TEMPERATURE=0.1

# --- Ollama (local fallback, Phase 6, optional) ------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
# Ollama defaults to 2048 regardless of the model's real window, which
# truncates prompts from the front and eats your instructions. Set it.
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=45

# --- This service ------------------------------------------------------------
AGENT_PORT=8000

# Must be IDENTICAL to AGENT_SECRET in server/.env.
AGENT_SECRET=generate-your-own-32-char-hex-string

# --- ChromaDB (incident memory, Phase 6) -------------------------------------
CHROMA_PATH=./chroma_data
CHROMA_COLLECTION=incident_memory
MEMORY_TOP_K=3

# --- Behaviour ---------------------------------------------------------------
REPAIR_RETRIES=1
LOG_PROMPTS=false
