# =============================================================================
# TEMPLATE — copy to .env and fill in.
#
#   Windows:  Copy-Item .env.example .env
#   macOS:    cp .env.example .env
#
# This file IS committed. The .env you create from it is NOT.
# =============================================================================

# --- Platform database (sre-postgres) ----------------------------------------
# Port 5434, not 5432 — 5432 is often taken by a native Postgres install, and
# a clash makes Node connect to the wrong database with a very confusing
# "password authentication failed" error.
DB_HOST=localhost
DB_PORT=5434
DB_USER=sre
DB_PASSWORD=sre_dev_password
DB_NAME=sre_platform

# --- This server -------------------------------------------------------------
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Docker ------------------------------------------------------------------
# Windows named pipe. On macOS/Linux: /var/run/docker.sock
DOCKER_SOCKET=//./pipe/docker_engine

# --- Python agent service (Phase 4) ------------------------------------------
# AGENT_SECRET must be IDENTICAL to the one in agents/.env.
# Generate one:  node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
AGENT_URL=http://localhost:8000
AGENT_SECRET=generate-your-own-32-char-hex-string
AGENT_TIMEOUT_MS=30000

# --- Demo target (Phase 3) ---------------------------------------------------
# Where the fault-injection route reaches demo-api's /debug endpoints.
DEMO_API_URL=http://localhost:3001

# --- Auth (Phase 5) ----------------------------------------------------------
# Generate:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
JWT_SECRET=generate-your-own-long-random-string
JWT_EXPIRES_IN=8h

DEMO_OPERATOR_USER=priya
DEMO_OPERATOR_PASSWORD=operator123
DEMO_VIEWER_USER=viewer
DEMO_VIEWER_PASSWORD=viewer123

# --- Monitoring --------------------------------------------------------------
POLL_INTERVAL_MS=3000
SUSTAIN_WINDOW_MS=30000        # drop to ~8000 for a live demo
COOLDOWN_MS=60000
MAX_RESTARTS_PER_HOUR=3
APPROVAL_TTL_MINUTES=5
AUTO_APPROVE_CONFIDENCE=0.95

# --- Data retention ----------------------------------------------------------
METRICS_RETENTION_HOURS=2
